rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // For a trusted group: one counter (counters/omg) plus a history of presses under it.
    // A press adds a history entry (who, when, 1 to 10 presses) and raises the count in one batch.
    // Anyone on the page may rename or delete an entry; deleting lowers the count by the
    // entry's size in the same transaction. The count can never go below 0.
    match /counters/omg {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0;

      match /presses/{pressId} {
        allow read, delete: if true;
        allow create: if request.resource.data.keys().hasOnly(['by', 'at', 'n'])
          && request.resource.data.keys().hasAll(['by', 'at', 'n'])
          && validName(request.resource.data.by)
          && request.resource.data.at == request.time
          && request.resource.data.n is int
          && request.resource.data.n >= 1
          && request.resource.data.n <= 10;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['by'])
          && validName(request.resource.data.by);
      }
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
